{
  "$description": "Elevação → Effect Styles no Figma. Deliberadamente sem modos: Effect Styles do Figma não aceitam modos de variável, então uma sombra que mudasse entre claro e escuro seria impossível de espelhar. Usamos preto translúcido, que funciona nos dois.",
  "elevation": {
    "none": {
      "$type": "shadow",
      "$value": [{ "color": "#00000000", "offsetX": "0px", "offsetY": "0px", "blur": "0px", "spread": "0px" }]
    },
    "xs": {
      "$type": "shadow",
      "$value": [{ "color": "#100d1614", "offsetX": "0px", "offsetY": "1px", "blur": "2px", "spread": "0px" }]
    },
    "sm": {
      "$type": "shadow",
      "$value": [
        { "color": "#100d1614", "offsetX": "0px", "offsetY": "1px", "blur": "3px", "spread": "0px" },
        { "color": "#100d160f", "offsetX": "0px", "offsetY": "1px", "blur": "2px", "spread": "-1px" }
      ]
    },
    "md": {
      "$type": "shadow",
      "$value": [
        { "color": "#100d1614", "offsetX": "0px", "offsetY": "4px", "blur": "8px", "spread": "-2px" },
        { "color": "#100d160f", "offsetX": "0px", "offsetY": "2px", "blur": "4px", "spread": "-2px" }
      ]
    },
    "lg": {
      "$type": "shadow",
      "$value": [
        { "color": "#100d1617", "offsetX": "0px", "offsetY": "12px", "blur": "16px", "spread": "-4px" },
        { "color": "#100d160f", "offsetX": "0px", "offsetY": "4px", "blur": "6px", "spread": "-2px" }
      ]
    },
    "xl": {
      "$type": "shadow",
      "$value": [
        { "color": "#100d161a", "offsetX": "0px", "offsetY": "20px", "blur": "24px", "spread": "-4px" },
        { "color": "#100d160f", "offsetX": "0px", "offsetY": "8px", "blur": "8px", "spread": "-4px" }
      ]
    },
    "2xl": {
      "$type": "shadow",
      "$value": [{ "color": "#100d162e", "offsetX": "0px", "offsetY": "24px", "blur": "48px", "spread": "-12px" }]
    }
  }
}
