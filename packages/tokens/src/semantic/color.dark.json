        "$value": "{palette.neutral.800}"
      },
      "default": { "$type": "color", "$value": "{palette.neutral.500}" },
      "strong": { "$type": "color", "$value": "{palette.neutral.400}" },
      "brand": { "$type": "color", "$value": "{palette.brand.500}" },
      "success": { "$type": "color", "$value": "{palette.success.500}" },
      "warning": { "$type": "color", "$value": "{palette.warning.400}" },
      "danger": { "$type": "color", "$value": "{palette.danger.500}" },
      "info": { "$type": "color", "$value": "{palette.info.500}" },
      "focus": { "$type": "color", "$value": "{palette.brand.400}" },
      "disabled": { "$type": "color", "$value": "{palette.neutral.800}" }
    },
    "icon": {
      "primary": { "$type": "color", "$value": "{palette.neutral.200}" },
      "secondary": { "$type": "color", "$value": "{palette.neutral.400}" },
      "tertiary": { "$type": "color", "$value": "{palette.neutral.500}" },
      "disabled": { "$type": "color", "$value": "{palette.neutral.600}" },
      "on-brand": { "$type": "color", "$value": "{palette.neutral.0}" },
      "on-neutral": { "$type": "color", "$value": "{palette.neutral.0}" },
      "on-accent": { "$type": "color", "$value": "{palette.accent.950}" },
      "on-success": { "$type": "color", "$value": "{palette.success.950}" },
      "on-warning": { "$type": "color", "$value": "{palette.warning.950}" },
      "on-danger": { "$type": "color", "$value": "{palette.neutral.0}" },
      "on-info": { "$type": "color", "$value": "{palette.neutral.0}" },
      "brand": { "$type": "color", "$value": "{palette.brand.400}" },
      "accent": { "$type": "color", "$value": "{palette.accent.400}" },
      "success": { "$type": "color", "$value": "{palette.success.400}" },
      "warning": { "$type": "color", "$value": "{palette.warning.400}" },
      "danger": { "$type": "color", "$value": "{palette.danger.400}" },
      "info": { "$type": "color", "$value": "{palette.info.400}" }
    }
  }
}
