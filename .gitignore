# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# orquestracao local do time de agentes (papeis do Maestri, nao e codigo)
.maestri/

# cache local regeneravel (inventario de icones do Figma: node scripts/figma-icons.mjs inventory)
tokens/.cache/

# contexto para download: gerados por scripts/build-contexto.mjs (prebuild/predev).
# Os .md escritos a mao (00, 01, 04) ficam versionados.
public/contexto/02-tokens.md
public/contexto/03-componentes.md
public/contexto/05-regras-e-rubricas.md
public/contexto/06-figma.md
public/contexto/santods-contexto-completo.txt
public/contexto/indice.json
