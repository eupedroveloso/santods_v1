# Banco do Estúdio (/estudio). Sem ESTUDIO_DATABASE_URL vale o SQLite local data/estudio.db (gitignored).
# Nome próprio de propósito: um DATABASE_URL genérico no ambiente (outro projeto) não pode sequestrar o banco.
# Turso: ESTUDIO_DATABASE_URL=libsql://<banco>-<org>.turso.io e ESTUDIO_DATABASE_AUTH_TOKEN=<token>.
ESTUDIO_DATABASE_URL=file:data/estudio.db
ESTUDIO_DATABASE_AUTH_TOKEN=
