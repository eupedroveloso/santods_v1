# @dev-mbr/icons é privado e mora no GitHub Packages, não no registry público.
# Só o mapeamento do escopo vive aqui — ele não é segredo.
#
# O TOKEN NÃO ENTRA NESTE ARQUIVO, e não adianta tentar: o pnpm se recusa a
# expandir credencial vinda de `.npmrc` de projeto, porque esse arquivo é
# versionado e o segredo vazaria para qualquer registry que alguém apontasse
# aqui. Uma linha `_authToken` aqui é ignorada com aviso, não é lida.
#
# O lugar certo é o `~/.npmrc` do usuário:
#   pnpm config set "//npm.pkg.github.com/:_authToken" <token com read:packages>
# Em CI, use o secret do workflow escrevendo no ~/.npmrc do runner.
@dev-mbr:registry=https://npm.pkg.github.com

auto-install-peers=true
strict-peer-dependencies=false
# Storybook, Next e Tailwind precisam de hoisting parcial para resolver plugins
public-hoist-pattern[]=*eslint*
public-hoist-pattern[]=*prettier*
public-hoist-pattern[]=*storybook*
public-hoist-pattern[]=*tailwindcss*
